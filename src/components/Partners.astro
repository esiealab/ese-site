---
import { Image } from 'astro:assets';
import { getEditionSponsors } from '../lib/content';

interface Props { year: number }
const { year } = Astro.props;
const sponsors = await getEditionSponsors(year);

// Les logos vivent dans src/assets/ : Astro les optimise et connaît leurs
// dimensions, ce qui évite d'avoir à les saisir dans les données.
const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/partners/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
---

{sponsors.length > 0 && (
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h2 class="font-display text-2xl font-bold">{sponsors.length > 1 ? 'Partenaires' : 'Partenaire'}</h2>
    <ul class="mt-4 flex flex-wrap items-center gap-6">
      {sponsors.map((s) => {
        const asset = logos[`/src/assets/partners/${s.data.logo}`];
        if (!asset) throw new Error(`src/assets/partners/${s.data.logo} est introuvable (sponsor ${s.id}).`);
        return (
          <li>
            <a href={s.data.url} class="inline-flex items-center">
              <Image src={asset.default} alt={s.data.name} height={64} densities={[1, 2]} class="h-16 w-auto" />
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
