---
import { Image } from 'astro:assets';
import background from '../assets/header-bg.jpg';
import { formatDateLong, type Edition } from '../lib/content';

interface Props {
  edition: Edition;
  siteName: string;
  cta?: { href: string; label: string } | null;
}
const { edition, siteName, cta } = Astro.props;
const d = edition.data;
---

<section class="relative isolate overflow-hidden bg-ese-dark">
  <Image
    src={background}
    alt=""
    widths={[640, 1024, 1600]}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35"
  />

  <div class="mx-auto max-w-4xl px-4 py-16 text-center text-white sm:py-24">
    <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-ese-secondary">{siteName}</p>

    <h1 class="mt-2 font-display text-3xl font-bold leading-tight sm:text-5xl">
      ESE {d.year}
    </h1>

    <p class="mt-3 text-lg sm:text-xl">
      {d.date ? formatDateLong(d.date) : 'Date à venir'}
      {d.venue && <> — {d.venue}</>}
    </p>

    {cta && (
      <p class="mt-6">
        <a
          class="inline-flex min-h-11 w-full items-center justify-center rounded bg-ese-primary px-6 font-display font-bold text-white hover:bg-ese-secondary hover:text-ese-dark sm:w-auto"
          href={cta.href}
        >
          {cta.label}
        </a>
      </p>
    )}
  </div>
</section>
