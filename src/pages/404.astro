---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable">
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="font-display text-3xl font-bold">Page introuvable</h1>
    <p class="mt-3 text-ese-muted">La page demandée n'existe pas ou a été déplacée.</p>
    <p class="mt-6 flex flex-wrap justify-center gap-4">
      <a class="inline-flex min-h-11 items-center font-bold text-ese-link hover:underline" href="/">Accueil</a>
      <a class="inline-flex min-h-11 items-center font-bold text-ese-link hover:underline" href="/archives/">Archives</a>
    </p>
  </section>
</Base>
