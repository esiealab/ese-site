---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

// Toutes les news, expirées comprises : /news/ est l'historique complet.
const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Actualités">
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="font-display text-3xl font-bold">Actualités</h1>
    <p class="mt-1 text-sm text-ese-muted">
      <a class="tap-target text-ese-link hover:underline" href="/rss.xml">Flux RSS</a>
    </p>

    {news.length > 0 ? (
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {news.map((entry) => <NewsCard entry={entry} headingLevel="h2" />)}
      </div>
    ) : (
      <p class="mt-6 text-ese-muted">Aucune actualité pour le moment.</p>
    )}
  </section>
</Base>
